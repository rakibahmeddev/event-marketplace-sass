# Copy to .env.local for local development. Never commit real keys.
# Secrets (payment keys, webhook secrets, QR signing secret, email keys) are NOT
# listed here — they live in Google Secret Manager and are read by Cloud Functions.

# --- Firebase web config (public by design; identifies the project, grants nothing) ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ticketing.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ticketing
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-ticketing.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Point the browser SDK at the local Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# --- Server (Admin SDK) ---
FIREBASE_PROJECT_ID=demo-ticketing
# When set, the Admin SDK talks to the emulators instead of production.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- App Check (reCAPTCHA Enterprise site key is public). Leave empty locally to skip App Check. ---
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional fixed debug token for local App Check (register it in the Firebase console first).
NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=
