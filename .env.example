# Copy to .env.local for local development. Never commit real keys.
# Deployed (Vercel): secrets live in Google Secret Manager only — see docs/deploy.md. The secret values below
# are for local development; a deployment that sets them refuses to start (lib/env.ts).

# --- Firebase web config (public by design; identifies the project, grants nothing) ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ticketing.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ticketing
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-ticketing.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# Point the browser SDK at the local Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# --- Server (Admin SDK) ---
FIREBASE_PROJECT_ID=demo-ticketing
FIREBASE_STORAGE_BUCKET=demo-ticketing.appspot.com
# When set, the Admin SDK talks to the emulators instead of production.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- App Check (reCAPTCHA Enterprise site key is public). Leave empty locally to skip App Check. ---
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional fixed debug token for local App Check (register it in the Firebase console first).
NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# --- Secrets: LOCAL ONLY (deployments read Secret Manager; never NEXT_PUBLIC_*) ---
# Signs ticket QR codes (HMAC-SHA256). Must match the Cloud Functions secret QR_SIGNING_SECRET. 32+ random chars.
QR_SIGNING_SECRET=
# Stripe Connect (platform account). Leave empty to use the local test payment provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local test payment provider only (refused in production). 32+ random chars.
TEST_PAYMENT_WEBHOOK_SECRET=

# --- Deployment only (Vercel; leave unset locally) — see docs/deploy.md ---
# SECRET_SOURCE=secret-manager
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/<number>/locations/global/workloadIdentityPools/vercel/providers/vercel
# GCP_SERVICE_ACCOUNT_EMAIL=web-app@<project>.iam.gserviceaccount.com
